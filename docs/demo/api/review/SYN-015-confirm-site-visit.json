{
 "rules": [
  {
   "id": "R1",
   "title": "Poor habitat",
   "kind": "condition",
   "points": {
    "environment": 2
   },
   "when": "mean of the visual habitat scores <= 5 (of 10)",
   "why": "Degraded banks, channel and riparian strip reduce the stream's ability to clean itself and to host life.",
   "advice": "Share with the city's river restoration team; repeat the visual check each season.",
   "flowing_only": true,
   "clears_after": "1 trusted clear visit"
  },
  {
   "id": "R2",
   "title": "Nutrient enrichment",
   "kind": "condition",
   "points": {
    "environment": 2
   },
   "when": "nitrate >= 25 mg/L as NO3 or phosphate >= 0.5 mg/L (demo thresholds)",
   "why": "Extra nutrients feed algae; algae use up oxygen and can include toxin-producing cyanobacteria.",
   "advice": "Look upstream for run-off sources (fields, allotments, outfalls) and keep monitoring.",
   "flowing_only": false,
   "clears_after": "1 trusted clear visit"
  },
  {
   "id": "R3",
   "title": "Possible cyanobacterial bloom",
   "kind": "hazard",
   "points": {
    "animal": 3,
    "human": 2
   },
   "when": "surface = algal-scum, or water-colour = green with water >= 20 C; not counted if the jar/stick test points to harmless green or filamentous algae",
   "why": "Scums in warm water are typical of cyanobacterial blooms, which can poison dogs, livestock and people. Only a lab test can confirm toxins.",
   "advice": "Keep dogs and children out of the water and report the bloom to the local authority for testing.",
   "flowing_only": false,
   "clears_after": "2 trusted clear visits >= 7 days apart"
  },
  {
   "id": "R4",
   "title": "Sewage signal",
   "kind": "hazard",
   "points": {
    "human": 3,
    "environment": 1
   },
   "when": "odour = sewage or water-colour = milky-grey",
   "why": "Sewage smell or grey water suggests faecal contamination, a route for gut infections in people and animals.",
   "advice": "Avoid touching the water, wash hands, and report it to the water utility or municipality.",
   "flowing_only": false,
   "clears_after": "2 trusted clear visits >= 7 days apart"
  },
  {
   "id": "R5",
   "title": "Dead fish",
   "kind": "hazard",
   "points": {
    "animal": 3,
    "environment": 1
   },
   "when": "dead-fish = yes",
   "why": "Fish kills point to low oxygen, toxins or pollution - an early warning for other animals.",
   "advice": "Do not touch the fish; note how many and report to the environment authority.",
   "flowing_only": false,
   "clears_after": "2 trusted clear visits >= 7 days apart"
  },
  {
   "id": "R6",
   "title": "People in contact with affected water",
   "kind": "hazard",
   "points": {
    "human": 2
   },
   "when": "people-contact = yes while R3 or R4 fired at the site",
   "why": "Exposure turns a water problem into a human-health problem.",
   "advice": "Discourage paddling and swimming here until the signal has been checked.",
   "flowing_only": false,
   "clears_after": "2 trusted clear visits >= 7 days apart"
  },
  {
   "id": "R7",
   "title": "Pets or livestock in contact with affected water",
   "kind": "hazard",
   "points": {
    "animal": 2
   },
   "when": "animal-contact = yes while R3, R4 or R5 fired at the site",
   "why": "Dogs and livestock drink and swim in affected water and are often the first victims of blooms.",
   "advice": "Keep pets and livestock out of the water and away from scum on the shore.",
   "flowing_only": false,
   "clears_after": "2 trusted clear visits >= 7 days apart"
  },
  {
   "id": "R8",
   "title": "Oil or chemical signal",
   "kind": "hazard",
   "points": {
    "environment": 2,
    "human": 1
   },
   "when": "surface = oily-sheen or odour = chemical",
   "why": "Hydrocarbons and chemicals harm aquatic life and can irritate skin on contact.",
   "advice": "Avoid skin contact and report the sheen or smell to the environment authority.",
   "flowing_only": false,
   "clears_after": "2 trusted clear visits >= 7 days apart"
  },
  {
   "id": "R9",
   "title": "Nitrate above drinking-water value",
   "kind": "condition",
   "points": {
    "human": 1
   },
   "when": "nitrate >= 50 mg/L as NO3 (the EU drinking-water parametric value, used only as an awareness anchor)",
   "why": "Stream water is not drinking water, but this level signals run-off that may reach wells and supplies.",
   "advice": "Mention it to the water utility; private well owners nearby may want a lab test.",
   "flowing_only": false,
   "clears_after": "1 trusted clear visit"
  },
  {
   "id": "R10",
   "title": "No mayfly, stonefly or caddisfly larvae found",
   "kind": "condition",
   "points": {
    "environment": 2
   },
   "when": "sensitive-invertebrates = 0 after >= 1 minute of kick-net sampling in a flowing reach",
   "why": "Most families of these groups need clean, oxygen-rich water, so finding none suggests poorer conditions over weeks. Some families tolerate pollution, so this is a coarse screen, not a biotic index.",
   "advice": "Repeat the sample in a riffle; if still none, share with the ecology team for a full index.",
   "flowing_only": true,
   "clears_after": "1 trusted clear visit"
  }
 ],
